; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CultivationGame"
config/description="Xianxia cultivation life-sim"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "C#")

[autoload]

GameBoot="*res://src/Adapter/Scene/GameBoot.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="CultivationGame"

[logging]

; R40-4 (репорт 18.10 №4 «тихий краш при Alt-Tab без лога»): файловый лог
; Godot 4.7 пишется в user://logs/godot.log + ротация godot.<timestamp>.log
; (Windows: %APPDATA%\Godot\app_userdata\CultivationGame\logs\). Дефолт уже
; работает (эмпирически, аудит r40-b), но секция делает его явным и задаёт
; потолок ротации — краш-хвост/последние строки при тихом падении попадают
; в файл (stdout консоли теряется при закрытии окна движка).
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/max_log_files=10

[rendering]

textures/canvas_textures/default_texture_filter=0
