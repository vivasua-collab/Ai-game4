[resource]
default_font_size = 19
Panel/styles/panel = SubResource("StyleBoxFlat_panel")
Button/colors/font_color = Color(0.165, 0.114, 0.063, 1)
Button/colors/font_hover_color = Color(0.165, 0.114, 0.063, 1)
Button/colors/font_pressed_color = Color(0.165, 0.114, 0.063, 1)
Button/colors/font_disabled_color = Color(0.353, 0.290, 0.208, 1)
Button/colors/font_focus_color = Color(0.165, 0.114, 0.063, 1)
Button/styles/normal = SubResource("StyleBoxFlat_button_normal")
Button/styles/hover = SubResource("StyleBoxFlat_button_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_button_pressed")
Button/styles/disabled = SubResource("StyleBoxFlat_button_disabled")
Button/styles/focus = SubResource("StyleBoxFlat_button_hover")
Label/colors/font_color = Color(0.165, 0.114, 0.063, 1)
Label/colors/font_outline_color = Color(0.961, 0.910, 0.784, 1)
LineEdit/colors/font_color = Color(0.165, 0.114, 0.063, 1)
LineEdit/colors/font_selected_color = Color(0.961, 0.910, 0.784, 1)
LineEdit/colors/caret_color = Color(0.165, 0.114, 0.063, 1)
LineEdit/colors/selection_color = Color(0.722, 0.525, 0.043, 1)
LineEdit/styles/normal = SubResource("StyleBoxFlat_lineedit_normal")
LineEdit/styles/focus = SubResource("StyleBoxFlat_lineedit_normal")
