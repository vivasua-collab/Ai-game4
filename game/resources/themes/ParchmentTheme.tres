; Theme resource: «Древний Пергамент» (Ancient Parchment)
; Colors from docs_v2/07_ui/UI_DESIGN.md §2.1
;   Parchment Base  #e8d5a8  -> Color(0.910, 0.835, 0.659, 1)
;   Parchment Dark  #c9a878  -> Color(0.788, 0.659, 0.471, 1)
;   Parchment Light #f5e8c8  -> Color(0.961, 0.910, 0.784, 1)
;   Ink Black       #2a1d10  -> Color(0.165, 0.114, 0.063, 1)
;   Ink Faded       #5a4a35  -> Color(0.353, 0.290, 0.208, 1)
;   Accent Gold     #b8860b  -> Color(0.722, 0.525, 0.043, 1)
;   Accent Red      #8b0000  -> Color(0.545, 0.000, 0.000, 1)
;   Accent Green    #4a6b3a  -> Color(0.290, 0.420, 0.227, 1)
;
; Default font size: 18‰ of 1080 = 19.44 → 19 px (floor)
; Full per-element theme (rarity colors, status colors, etc.) is assembled
; programmatically by ParchmentTheme.cs. This .tres provides the base
; appearance so the UI is usable even before C# initialization.

[gd_resource type="Theme" format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.910, 0.835, 0.659, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.788, 0.659, 0.471, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0

