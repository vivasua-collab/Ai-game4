# Auto-detect text files
* text=auto

# Source files — LF line endings
*.cs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Godot scene/resource files — LF (text-based, must stay text)
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf

# Binary assets — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
